# ─── Required ──────────────────────────────────────────────
# Backend: Resend API key for contact form emails
RESEND_API_KEY=re_placeholder

# ─── Optional ──────────────────────────────────────────────
# GitHub: Personal Access Token (public_repo scope) for API rate limiting
# Without this, the GitHub section uses unauthenticated requests (60 req/h)
GITHUB_TOKEN=ghp_placeholder

# ─── Frontend ──────────────────────────────────────────────
# Public API URL (used by Next.js for client-side contact form)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ─── Backend ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
EMAIL_FROM=Portfolio Contact <onboarding@resend.dev>
EMAIL_TO=diego1silva2@gmail.com
