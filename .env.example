# ─── Required ──────────────────────────────────────────────
# Backend: Resend API key for contact form emails
RESEND_API_KEY=re_placeholder

# ─── Optional ──────────────────────────────────────────────
# GitHub: Personal Access Token (public_repo scope) for API rate limiting
# Without this, the GitHub section uses unauthenticated requests (60 req/h)
GITHUB_TOKEN=ghp_placeholder

# ─── Frontend ──────────────────────────────────────────────
# Public API URL (used by Next.js for client-side contact form)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ─── Backend ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
EMAIL_FROM=Portfolio Contact <onboarding@resend.dev>
EMAIL_TO=diego1silva2@gmail.com

# ─── Database (PostgreSQL) ─────────────────────────────────
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=portfolio
# Used by the backend outside docker compose (compose builds it from the
# POSTGRES_* vars above, with host `db`). Placeholder only — never commit
# real credentials.
DATABASE_URL=postgresql://portfolio_user:change_me_postgres_password@localhost:5432/portfolio

# ─── Analytics / Admin ─────────────────────────────────────
# Admin session JWT secret — generate with: openssl rand -hex 32
# Must be at least 32 characters. Placeholder only.
ADMIN_JWT_SECRET=change_me_at_least_32_characters_long_secret
# Salt for hashing visitor IPs (privacy: raw IPs are never stored).
# Must be at least 32 characters — generate with: openssl rand -hex 32
ANALYTICS_IP_SALT=change_me_random_salt_at_least_32_chars_long
# Set to 1/true or proxy hop count when behind a reverse proxy (enables
# Express trust proxy so req.ip / rate limits use the real client IP).
# Leave empty when the backend is exposed directly.
TRUST_PROXY=
# Cookie policy for the admin session cookie: strict | lax | none
COOKIE_SAMESITE=strict
# Admin session lifetime in hours
SESSION_TTL_HOURS=24

# ─── Admin seed (seed-time only) ───────────────────────────
# Used ONLY by `npm run db:seed` in backend/ to create/update the admin
# user. Not needed at runtime. Password must be at least 8 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
