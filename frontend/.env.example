# Frontend Environment Variables
# Copy to .env.local for local development

# ─── API ───────────────────────────────────────────────────
# Backend API URL for the contact form
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ─── GitHub ────────────────────────────────────────────────
# Personal Access Token with public_repo scope
# Used to increase GitHub API rate limit (5000 req/h vs 60 req/h)
# Optional: the app works without it but falls back to unauthenticated requests
GITHUB_TOKEN=ghp_your_token_here

# ─── Vercel (production only) ─────────────────────────────
# These are set automatically by Vercel, no need to configure locally
# NEXT_PUBLIC_VERCEL_URL
