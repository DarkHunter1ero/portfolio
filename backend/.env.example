# Backend
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
RESEND_API_KEY=re_placeholder
EMAIL_FROM=Portfolio Contact <onboarding@resend.dev>
EMAIL_TO=diego1silva2@gmail.com

# Database (PostgreSQL)
DATABASE_URL=postgresql://portfolio_user:change_me_postgres_password@localhost:5432/portfolio

# Analytics / Admin
# Admin session JWT secret — generate with: openssl rand -hex 32
# Must be at least 32 characters. Placeholder only.
ADMIN_JWT_SECRET=change_me_at_least_32_characters_long_secret
# Salt for hashing visitor IPs (privacy: raw IPs are never stored).
# Must be at least 32 characters — generate with: openssl rand -hex 32
ANALYTICS_IP_SALT=change_me_random_salt_at_least_32_chars_long
# Set to 1/true or proxy hop count when behind a reverse proxy (enables
# Express trust proxy so req.ip / rate limits use the real client IP).
# Leave empty when the backend is exposed directly.
TRUST_PROXY=
# Cookie policy for the admin session cookie: strict | lax | none
COOKIE_SAMESITE=strict
# Admin session lifetime in hours
SESSION_TTL_HOURS=24

# Admin seed (seed-time only, used by `npm run db:seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
